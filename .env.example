# 服务监听端口
PORT=8080

# 转发目标主机（必填，两个都要配置）
# 只使用 scheme://host[:port]；即使配置里带了路径也会被丢弃
# 实际转发地址 = 主机源 + 当前请求路径
#
# FORWARD_URL_1=https://test-login.uka111.com
# POST /api/dcs/corporateVA/webhooks
#   -> https://test-login.uka111.com/api/dcs/corporateVA/webhooks
# POST /api/dcs/safeheron/webhook/transaction
#   -> https://test-login.uka111.com/api/dcs/safeheron/webhook/transaction
FORWARD_URL_1=https://test-login.uka111.com
FORWARD_URL_2=https://uat-login.uka111.com

# 转发超时（秒）
FORWARD_TIMEOUT=30
